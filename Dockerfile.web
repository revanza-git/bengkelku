FROM node:20-slim AS base
WORKDIR /app

FROM base AS deps
COPY package.json ./
# Fresh install without lock file to get correct native deps for Linux
RUN npm install --legacy-peer-deps
# Explicitly install rollup linux binary to fix platform-specific dependency issue
RUN npm install @rollup/rollup-linux-x64-gnu --legacy-peer-deps

FROM base AS dev
ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

FROM base AS build
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM nginx:1.25-alpine AS prod
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
